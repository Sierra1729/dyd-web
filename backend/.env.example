# Backend Server Configuration
PORT=5000

# =========================================================================
# Firebase Admin Configuration
# Option A (Recommended): Place your downloaded 'serviceAccountKey.json' file
#                         into the backend/ folder, or specify its path below:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# Option B: Paste the entire contents of your serviceAccountKey.json on one line:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"webdyd-56ba6",...}
# =========================================================================

# Cloudinary Configuration (For Profile Pictures, Marksheets & Resumes)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer - Gmail SMTP)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
